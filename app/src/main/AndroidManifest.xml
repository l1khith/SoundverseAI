<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notification runtime permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Internet for ExoPlayer streaming and FCM -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        READ_EXTERNAL_STORAGE / READ_MEDIA_VIDEO were previously declared for
        Instagram Stories sharing. Our share implementation uses a PackageManager
        intent launch (no direct file read), so these broad permissions are not
        needed and have been removed to satisfy Play Policy requirements.
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SoundverseAI">

        <!--
            android:label is intentionally omitted here — the application-level
            label above already supplies the launcher title. Declaring it again
            on the activity would be redundant (lint: RedundantLabel).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SoundverseAI"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">

            <!-- Launcher intent filter -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Custom URI scheme deep link: soundverse://export
                android:autoVerify is intentionally omitted — autoVerify is only
                valid for Android App Links (https:// scheme). A custom scheme
                like soundverse:// does not go through Digital Asset Links
                verification and does not need that attribute.

                tools:ignore="AppLinkUrlError" suppresses the lint rule that
                expects an http/https scheme whenever a VIEW intent filter is
                declared, which does not apply to custom URI schemes.
            -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="soundverse"
                    android:host="export" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging service -->
        <service
            android:name=".notification.SoundverseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            FCM default notification channel.
            "soundverse_channel" matches CHANNEL_ID in SoundverseMessagingService.
            tools:ignore="Typos" suppresses false-positive spell-checker warnings
            on the brand name "Soundverse".
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="soundverse_channel"
            tools:ignore="Typos" />

    </application>

</manifest>